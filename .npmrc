# Prevent installing dependency versions newer than 3 days old
minimum-release-age=4320

# Block all lifecycle scripts
ignore-scripts=true

# Enforce engine requirements
engine-strict=true

# Prefer headless installation when lockfile satisfies package.json
prefer-frozen-lockfile=true

# Add full tarball URL to every lockfile entry
lockfile-include-tarball-url=true

# Don't auto-install peers, fail if missing/invalid
auto-install-peers=false
strict-peer-dependencies=true
